# EmailJS configuration — no backend/database required.
# Create a free EmailJS account and create TWO templates:
# 1) Client confirmation template
# 2) Owner notification template
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key
VITE_EMAILJS_CLIENT_TEMPLATE_ID=your_client_confirmation_template_id
VITE_EMAILJS_OWNER_TEMPLATE_ID=your_owner_notification_template_id

# Put the real business email here. Do not commit a private email to public repos.
VITE_BUSINESS_EMAIL=your-business-email@example.com